NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (no NEXT_PUBLIC_ prefix — never exposed to the browser)
ASSOCONNECT_API_KEY=
ASSOCONNECT_ORGANIZATION_ULID=
SUPABASE_SERVICE_ROLE_KEY=

# Used to build Supabase Auth redirect links (invitation, password reset)
NEXT_PUBLIC_SITE_URL=https://assoconnect-ws1.vercel.app

# Master admins : adresses (virgules) toujours administrateur, indépendamment des fiches FMC.
MASTER_ADMINS=

# Liste blanche des destinataires (invitations, réinitialisations, e-mails Resend, relances).
# Adresses complètes ou domaines (@exemple.fr), séparés par des virgules. Vide => aucun e-mail ne part.
EMAILS_AUTORISES=

# E-mails (étape 6) : Resend ; sans clé, les envois sont simulés et journalisés.
RESEND_API_KEY=
EMAIL_FROM="ClimAccess <no-reply@example.com>"
# Vercel Cron : /api/cron/relances vérifie Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
